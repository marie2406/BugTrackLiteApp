<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:BugTrackLite.Converters"
             xmlns:vm="clr-namespace:BugTrackLite.ViewModels"
             x:Class="BugTrackLite.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Palette de couleurs ===== -->
            <Color x:Key="Primary">#4F46E5</Color>
            <Color x:Key="PageBg">#F5F6FA</Color>
            <Color x:Key="TextMain">#1F2430</Color>
            <Color x:Key="TextMuted">#6B7280</Color>
            <Color x:Key="Danger">#E5484D</Color>
            <Color x:Key="LineColor">#E4E7EE</Color>

            <!-- Convertisseur : texte non vide => visible -->
            <conv:StringNotEmptyConverter x:Key="NotEmpty" />

            <!-- ===== Styles globaux ===== -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBg}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
            </Style>

            <!-- Styles nommés -->
            <Style x:Key="Brand" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
            </Style>
            <Style x:Key="H1" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="Muted" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="Error" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource LineColor}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="StrokeShape">
                    <Setter.Value><RoundRectangle CornerRadius="14" /></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#EEF0FF" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,8,6" />
            </Style>

            <!-- ===== Carte de ticket réutilisée par les écrans À faire / En cours / Terminé =====
                 Les boutons s'affichent selon l'état du ticket (ShowStart, ShowBack, ShowFinish, ShowArchive). -->
            <DataTemplate x:Key="TicketCardTemplate">
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Code}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding AgeText}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" VerticalOptions="Start" Padding="10,4" StrokeThickness="0"
                                    BackgroundColor="{Binding PriorityColor}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Label Text="{Binding PriorityText}" TextColor="White" FontSize="12" />
                            </Border>
                        </Grid>
                        <FlexLayout Wrap="Wrap">
                            <Button Text="Détails" Style="{StaticResource SmallButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketListViewModel}}, Path=OpenDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Démarrer" Style="{StaticResource SmallButton}" IsVisible="{Binding ShowStart}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketListViewModel}}, Path=StartCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Remettre à faire" Style="{StaticResource SmallButton}" IsVisible="{Binding ShowBack}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketListViewModel}}, Path=BackToTodoCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Terminer" Style="{StaticResource SmallButton}" IsVisible="{Binding ShowFinish}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketListViewModel}}, Path=FinishCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Archiver" Style="{StaticResource SmallButton}" IsVisible="{Binding ShowArchive}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TicketListViewModel}}, Path=ArchiveCommand}"
                                    CommandParameter="{Binding .}" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
