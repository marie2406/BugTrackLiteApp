<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BugTrackLite.ViewModels"
             x:Class="BugTrackLite.Views.AddTicketPage"
             Title="Nouveau ticket" Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">
            <Label Text="BUGTRACKLITE · AJOUTER" Style="{StaticResource Brand}" />
            <Label Text="Nouveau ticket" Style="{StaticResource H1}" />
            <Label Text="Ajoutons les tâches du jour" Style="{StaticResource Muted}" Margin="0,0,0,8" />

            <Label Text="Titre du ticket" />
            <Entry Text="{Binding Title}" Placeholder="Ex. Corriger le bouton Connexion" />
            <Label Text="{Binding TitleError}" Style="{StaticResource Error}" IsVisible="{Binding TitleError, Converter={StaticResource NotEmpty}}" />

            <Label Text="Priorité" />
            <Picker ItemsSource="{Binding Priorities}" SelectedIndex="{Binding PriorityIndex}" />

            <Label Text="Colonne initiale" />
            <Picker ItemsSource="{Binding Columns}" SelectedIndex="{Binding ColumnIndex}" />

            <Label Text="Note (optionnel)" />
            <Editor Text="{Binding Note}" Placeholder="Pourquoi cette tâche compte…" HeightRequest="100" />

            <Button Text="Ajouter le ticket" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,10,0,0" />
            <Button Text="ANNULER" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
