<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BugTrackLite.ViewModels"
             x:Class="BugTrackLite.Views.DonePage">
    <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="12">
        <VerticalStackLayout Spacing="6">
            <Label Text="BUGTRACKLITE · TERMINÉ" Style="{StaticResource Brand}" />
            <Label Text="{Binding Title}" Style="{StaticResource H1}" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
            <Border Style="{StaticResource Card}" BackgroundColor="#EAF7F0"
                    IsVisible="{Binding BannerTitle, Converter={StaticResource NotEmpty}}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding BannerTitle}" FontAttributes="Bold" TextColor="#30A46C" />
                    <Label Text="{Binding BannerText}" />
                </VerticalStackLayout>
            </Border>
            <!-- Choix de la période -->
            <Picker ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Title="Choix période" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Tickets}"
                        ItemTemplate="{StaticResource TicketCardTemplate}"
                        EmptyView="{Binding EmptyMessage}" />
    </Grid>
</ContentPage>
