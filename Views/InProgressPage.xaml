<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BugTrackLite.ViewModels"
             x:Class="BugTrackLite.Views.InProgressPage">
    <Grid RowDefinitions="Auto,*" Padding="20,20,20,0" RowSpacing="12">
        <VerticalStackLayout Spacing="6">
            <Label Text="BUGTRACKLITE · EN COURS" Style="{StaticResource Brand}" />
            <Label Text="{Binding Title}" Style="{StaticResource H1}" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
            <!-- Encadré "Focus" : affiché seulement s'il y a des tâches prioritaires -->
            <Border Style="{StaticResource Card}" BackgroundColor="#EEF0FF"
                    IsVisible="{Binding BannerTitle, Converter={StaticResource NotEmpty}}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding BannerTitle}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding BannerText}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Tickets}"
                        ItemTemplate="{StaticResource TicketCardTemplate}"
                        EmptyView="{Binding EmptyMessage}" />
    </Grid>
</ContentPage>
