<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BugTrackLite.ViewModels"
             x:Class="BugTrackLite.Views.MorePage">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="BUGTRACKLITE · PLUS" Style="{StaticResource Brand}" />
        <Label Text="Plus" Style="{StaticResource H1}" />
        <Border Style="{StaticResource Card}">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="add" /></Border.GestureRecognizers>
            <Label Text="＋  Nouveau ticket" FontSize="16" />
        </Border>
        <Border Style="{StaticResource Card}">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="search" /></Border.GestureRecognizers>
            <Label Text="⌕  Recherche &amp; filtres" FontSize="16" />
        </Border>
        <Border Style="{StaticResource Card}">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="stats" /></Border.GestureRecognizers>
            <Label Text="▤  Statistiques" FontSize="16" />
        </Border>
        <Border Style="{StaticResource Card}">
            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="settings" /></Border.GestureRecognizers>
            <Label Text="⚙  Réglages" FontSize="16" />
        </Border>
    </VerticalStackLayout>
</ContentPage>
